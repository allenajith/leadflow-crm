# Safety net for the repo root.
# Each package (server/, frontend/) has its own .gitignore as well.

node_modules/
dist/
build/

# Env files — never commit secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
